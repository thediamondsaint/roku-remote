#!/usr/bin/env python3
"""Control Roku devices over the local network (ECP, port 8060).

  roku list                     scan and list reachable and remembered offline Rokus
  roku [-d NAME] wake            send Wake-on-LAN and wait for the TV
  roku remember NAME IP [MAC]    remember a TV manually
  roku [-d NAME] inventory [--json]  read device details, apps, and playback state
  roku [-d NAME] KEY...         send keys: home up down left right select back play
                                rev fwd volup voldown mute power info replay ...
  roku [-d NAME] type "text"    type text into an on-screen keyboard
  roku [-d NAME] apps           list installed apps
  roku [-d NAME] launch APP     launch an app by (partial) name or id (`roku netflix` works too)
  roku [-d NAME] status         power state / active app
  roku [-d NAME] volume [0-100] read or set the exact TV volume
  roku [-d NAME] yodel-nuke    volume 25 / YouTube for 25 seconds, then restore (all TVs by default)
  roku [-d NAME] yodel-restore retry restoration after an interrupted Yodel Nuke
  roku [-d NAME] info           JSON: device, power, active app, apps (used by the GUI)
  roku default NAME             remember the default device

Repeat a key with KEY*N, e.g. `roku down*5 select`.
NAME is a case-insensitive substring of the device name, or an IP address.
"""
import base64
import concurrent.futures as cf
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import time
import tempfile
import urllib.parse
import urllib.request
import xml.etree.ElementTree as ET

CACHE = os.path.expanduser("~/.cache/roku.json")
PREFERENCES = os.path.expanduser("~/.config/roku-remote/shortcuts.json")
REGISTRY = os.path.expanduser("~/.config/roku-remote/devices.json")
INVENTORY_CACHE = os.path.expanduser("~/.cache/roku-inventory.json")
PORT = 8060

ALIASES = {
    "volup": "VolumeUp", "voldown": "VolumeDown", "mute": "VolumeMute",
    "power": "Power", "poweroff": "PowerOff", "poweron": "PowerOn",
    "ok": "Select", "enter": "Select", "esc": "Back", "pause": "Play",
    "ff": "Fwd", "rw": "Rev", "input": "InputHDMI1",
}
KEYS = ["Home", "Rev", "Fwd", "Play", "Select", "Left", "Right", "Down", "Up",
        "Back", "InstantReplay", "Info", "Backspace", "Search", "Enter",
        "VolumeDown", "VolumeMute", "VolumeUp", "PowerOff", "PowerOn", "Power",
        "ChannelUp", "ChannelDown", "InputTuner", "InputHDMI1", "InputHDMI2",
        "InputHDMI3", "InputHDMI4", "InputAV1", "FindRemote"]
KEYMAP = {k.lower(): k for k in KEYS}
KEYMAP["replay"] = "InstantReplay"


def load():
    try:
        with open(CACHE) as f:
            c = json.load(f)
    except (OSError, ValueError):
        c = {}
    if not isinstance(c, dict):
        c = {}
    devices = c.get("devices", {})
    if not isinstance(devices, dict):
        devices = {}
    return {"default": c.get("default") if isinstance(c.get("default"), str) else None,
            "devices": {ip: name for ip, name in devices.items() if isinstance(name, str)}}


def save_json(destination, c):
    directory = os.path.dirname(destination)
    os.makedirs(directory, exist_ok=True)
    path = None
    try:
        with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as f:
            path = f.name
            json.dump(c, f, indent=2)
        os.replace(path, destination)
    finally:
        if path and os.path.exists(path):
            os.unlink(path)


def save(c):
    save_json(CACHE, c)


def preferences():
    try:
        with open(PREFERENCES) as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def valid_shortcuts(value):
    return (isinstance(value, list) and len(value) == 4 and
            all(isinstance(a, dict) and isinstance(a.get("id"), str) and a["id"] and
                isinstance(a.get("name"), str) and a["name"] for a in value))


def valid_ip(value):
    try:
        return isinstance(value, str) and ipaddress.ip_address(value).version == 4
    except ValueError:
        return False


def registry():
    """Persistent device identities survive cache clearing and sleeping TVs."""
    try:
        with open(REGISTRY) as f:
            records = json.load(f)
        if isinstance(records, dict):
            return {ip: r for ip, r in records.items() if valid_ip(ip) and isinstance(r, dict)
                    and isinstance(r.get("name"), str) and isinstance(r.get("info", {}), dict)}
    except (OSError, ValueError):
        pass
    records = {ip: {"name": name, "info": {}, "reachable": None, "last_seen": None}
               for ip, name in load()["devices"].items() if valid_ip(ip)}
    try:
        with open(INVENTORY_CACHE) as f:
            report = json.load(f)
        for device in report if isinstance(report, list) else []:
            if not isinstance(device, dict) or not valid_ip(device.get("ip")):
                continue
            node = device.get("queries", {}).get("device-info", {})
            info = {c["tag"]: c.get("text", "") for c in node.get("children", [])}
            records[device["ip"]] = {"name": device.get("name", device["ip"]), "info": info,
                                     "reachable": None, "last_seen": None}
    except (OSError, ValueError, TypeError, KeyError, AttributeError):
        pass
    return records


def remember_info(ip, info):
    records = registry()
    record = records.get(ip, {})
    name = info.get("user-device-name") or info.get("friendly-device-name") or record.get("name") or ip
    record.update(name=name, info=info, reachable=True, last_seen=time.time())
    records[ip] = record
    save_json(REGISTRY, records)


def ssdp_discover(timeout=1):
    """Ask Rokus on the LAN to announce their control service."""
    request = ("M-SEARCH * HTTP/1.1\r\nHOST: 239.255.255.250:1900\r\n"
               'MAN: "ssdp:discover"\r\nMX: 1\r\nST: roku:ecp\r\n\r\n').encode()
    found = set()
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
            sock.settimeout(timeout)
            sock.sendto(request, ("239.255.255.250", 1900))
            deadline = time.monotonic() + timeout
            while time.monotonic() < deadline:
                sock.settimeout(max(0.01, deadline - time.monotonic()))
                data, _ = sock.recvfrom(8192)
                location = re.search(r"^location:\s*(\S+)", data.decode(errors="replace"), re.I | re.M)
                if location:
                    url = urllib.parse.urlsplit(location.group(1))
                    if url.scheme == "http" and valid_ip(url.hostname) and url.port == PORT:
                        found.add(url.hostname)
    except (OSError, ValueError):
        pass
    return found


def local_net():
    """The /24 (or smaller) network of the interface that carries the default route."""
    def run(*a):
        return subprocess.run(a, capture_output=True, text=True).stdout
    m = re.search(r"default via \S+ dev (\S+)", run("ip", "-4", "route", "show", "default"))
    args = ["ip", "-4", "-o", "addr", "show", "scope", "global"] + (["dev", m.group(1)] if m else [])
    for a in re.finditer(r"inet (\d+\.\d+\.\d+\.\d+/\d+)", run(*args)):
        iface = ipaddress.ip_interface(a.group(1))
        net = iface.network
        if net.prefixlen < 24:  # never sweep a huge network; scan our own /24
            net = ipaddress.ip_network(f"{iface.ip}/24", strict=False)
        return net
    sys.exit("roku: no local network found")


def probe(ip):
    s = socket.socket()
    s.settimeout(0.6)
    try:
        s.connect((str(ip), PORT))
    except OSError:
        return None
    finally:
        s.close()
    try:
        root = get(str(ip), "/query/device-info")
        g = lambda t: (root.findtext(t) or "").strip()
        return str(ip), g("user-device-name") or g("friendly-device-name") or g("model-name"), {c.tag: (c.text or "").strip() for c in root}
    except Exception:
        return None


def discover():
    records = registry()
    hosts = {str(ip) for ip in local_net().hosts()} | set(records) | ssdp_discover()
    with cf.ThreadPoolExecutor(128) as ex:
        found = [r for r in ex.map(probe, sorted(hosts)) if r]
    c = load()
    for record in records.values():
        record["reachable"] = False
    for ip, name, info in found:
        identity = info.get("device-id") or info.get("serial-number")
        old_ip = next((old for old, r in records.items() if old != ip and identity and
                       (r.get("info", {}).get("device-id") or r.get("info", {}).get("serial-number")) == identity), None)
        if old_ip:
            del records[old_ip]
            if c.get("default") == old_ip:
                c["default"] = ip
            shortcuts = preferences()
            if old_ip in shortcuts:
                shortcuts[ip] = shortcuts.pop(old_ip)
                save_json(PREFERENCES, shortcuts)
        records[ip] = {"name": name, "info": info, "reachable": True, "last_seen": time.time()}
    c["devices"] = {ip: r["name"] for ip, r in records.items()}
    save_json(REGISTRY, records)
    save(c)
    return c


def resolve(name, pick_first=False):
    c = load()
    name = name or c.get("default")
    if name and re.fullmatch(r"\d+\.\d+\.\d+\.\d+", name):
        try:
            return str(ipaddress.IPv4Address(name))
        except ValueError:
            sys.exit(f"roku: invalid IPv4 address {name!r}")
    if not c["devices"]:
        c = discover()
    devs = {ip: r["name"] for ip, r in registry().items()}
    devs.update(c["devices"])
    if not name:
        if not devs:
            sys.exit("roku: no Roku found on the local network (is it on, and on the same subnet?)")
        if len(devs) == 1 or pick_first:
            online = [ip for ip, record in registry().items() if record.get("reachable")]
            return online[0] if online else next(iter(devs))
        sys.exit("roku: several devices found; pick one with -d NAME or `roku default NAME`\n"
                 + "\n".join(f"  {ip}  {n}" for ip, n in devs.items()))
    hits = [ip for ip, n in devs.items() if name.lower() in n.lower()]
    if not hits:  # cache may be stale
        devs = discover()["devices"]
        hits = [ip for ip, n in devs.items() if name.lower() in n.lower()]
    if len(hits) != 1:
        sys.exit(f"roku: {'no' if not hits else 'multiple'} device matches {name!r}")
    return hits[0]


def ecp_request(ip, path):
    script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "roku-ecp.cjs")
    try:
        result = subprocess.run(["node", script, ip, path], capture_output=True, text=True, timeout=12)
        if result.returncode:
            raise ValueError(result.stderr.strip() or "ECP-2 request failed")
        return json.loads(result.stdout)
    except (OSError, ValueError, subprocess.TimeoutExpired) as e:
        raise urllib.error.URLError(f"ECP-2: {e}") from e


def post(ip, path):
    req = urllib.request.Request(f"http://{ip}:{PORT}{path}", data=b"", method="POST")
    try:
        with urllib.request.urlopen(req, timeout=3) as response:
            response.read()
    except urllib.error.HTTPError as e:
        if e.code != 403:
            raise
        e.close()
        ecp_request(ip, path)


def get(ip, path):
    try:
        with urllib.request.urlopen(f"http://{ip}:{PORT}{path}", timeout=3) as response:
            return ET.fromstring(response.read())
    except urllib.error.HTTPError as e:
        if e.code != 403:
            raise
        try:
            response = ecp_request(ip, path)
            return ET.fromstring(base64.b64decode(response["content-data"], validate=True))
        except (urllib.error.URLError, ValueError, KeyError):
            raise e
        finally:
            e.close()


def apps(ip):
    return [(a.get("id"), a.text) for a in get(ip, "/query/apps").iter("app")]


def volume(ip):
    """Read the TV's global volume; never guess for unsupported devices."""
    try:
        value = int(get(ip, "/query/audio-device").findtext("global/volume"))
    except (TypeError, ValueError, ET.ParseError) as e:
        raise urllib.error.URLError("TV did not report a valid volume") from e
    if not 0 <= value <= 100:
        raise urllib.error.URLError("TV reported a volume outside 0-100")
    return value


def set_volume(ip, target, cancel=None):
    current = volume(ip)
    deadline = time.monotonic() + 60
    for _ in range(100):
        if cancel is not None and cancel.is_set():
            raise InterruptedError("Volume change cancelled")
        if time.monotonic() > deadline:
            raise urllib.error.URLError(f"Volume is {current}; target {target} timed out")
        if current == target:
            return current
        previous = current
        post(ip, "/keypress/VolumeUp" if current < target else "/keypress/VolumeDown")
        # Wait for feedback before sending another key, including on slow TVs.
        for _ in range(5):
            time.sleep(0.15)
            if cancel is not None and cancel.is_set():
                raise InterruptedError("Volume change cancelled")
            current = volume(ip)
            if current != previous:
                break
        if current == previous:
            raise urllib.error.URLError(f"Volume stopped responding at {current}; target {target} not confirmed")
    if current == target:
        return current
    raise urllib.error.URLError(f"Volume is {current}; target {target} not reached")


def xml_data(node):
    """Keep every returned XML field, including attributes and repeated children."""
    result = {"tag": node.tag, "attributes": dict(node.attrib)}
    text = (node.text or "").strip()
    if text:
        result["text"] = text
    if len(node):
        result["children"] = [xml_data(child) for child in node]
    return result


def wake_packet(mac):
    compact = re.sub(r"[:-]", "", mac)
    if not re.fullmatch(r"[0-9a-fA-F]{12}", compact):
        raise ValueError("invalid MAC address")
    return b"\xff" * 6 + bytes.fromhex(compact) * 16


def wake_device(ip, wait=20):
    record = registry().get(ip, {})
    info = record.get("info", {})
    macs = {info.get("wifi-mac"), info.get("ethernet-mac"), info.get("mac")}
    packets = []
    for mac in macs - {None, ""}:
        try:
            packets.append(wake_packet(mac))
        except ValueError:
            pass
    if not packets:
        sys.exit("roku: no saved MAC address for this TV. Scan while it is on, or use "
                 "`roku remember NAME IP MAC` first.")
    broadcasts = {"255.255.255.255", str(ipaddress.ip_network(ip + "/24", strict=False).broadcast_address)}
    with socket.socket(socket.AF_INET, socket.SOCK_DGRAM) as sock:
        sock.setsockopt(socket.SOL_SOCKET, socket.SO_BROADCAST, 1)
        for packet in packets:
            for address in broadcasts:
                sock.sendto(packet, (address, 9))
    deadline = time.monotonic() + wait
    while time.monotonic() < deadline:
        result = probe(ip)
        if result:
            remember_info(ip, result[2])
            return True
        time.sleep(1)
    return False


def power_on(ip):
    try:
        post(ip, "/keypress/PowerOn")
        return "Power-on command accepted"
    except urllib.error.HTTPError:
        raise
    except (urllib.error.URLError, OSError):
        if not wake_device(ip):
            sys.exit("roku: wake packets sent, but the TV has not responded. It may require Fast TV Start, "
                     "be disconnected, or have a new IP address. Run `roku list` to rescan.")
        post(ip, "/keypress/PowerOn")
        return "TV responded after Wake-on-LAN; power-on command accepted"


def inventory_device(device):
    ip, name = device
    record = registry().get(ip, {})
    result = {"ip": ip, "name": name, "queries": {}, "errors": {},
              "reachable": False, "last_seen": record.get("last_seen"), "cached": False}
    for endpoint in ("device-info", "apps", "active-app", "media-player"):
        try:
            node = get(ip, "/query/" + endpoint)
            result["queries"][endpoint] = xml_data(node)
            if endpoint == "device-info":
                result["reachable"] = True
                result["last_seen"] = time.time()
        except (urllib.error.URLError, OSError, ET.ParseError) as e:
            result["errors"][endpoint] = str(e)
            if isinstance(e, urllib.error.HTTPError):
                e.close()
            if endpoint == "device-info":
                info = record.get("info", {})
                if info:
                    result["queries"][endpoint] = {"tag": "device-info", "attributes": {},
                        "children": [{"tag": k, "attributes": {}, "text": v} for k, v in info.items()]}
                    result["cached"] = True
                break
    return result


def inventory(dev=None):
    if dev:
        ip = resolve(dev)
        devices = {ip: load()["devices"].get(ip, ip)}
    else:
        devices = discover()["devices"]
    with cf.ThreadPoolExecutor(max_workers=8) as executor:
        return list(executor.map(inventory_device, devices.items()))


def print_inventory(report):
    def lines(node, indent="  "):
        attributes = " ".join(f"{k}={v}" for k, v in node["attributes"].items())
        value = node.get("text", "")
        print(f"{indent}{node['tag']}: {value}" + (f" [{attributes}]" if attributes else ""))
        for child in node.get("children", []):
            lines(child, indent + "  ")
    if not report:
        print("No Rokus found in the local discovery subnet.")
    for device in report:
        print(f"\n{device['name']} ({device['ip']}) — {'reachable' if device['reachable'] else 'offline / unreachable'}" + (" (last known details)" if device["cached"] else ""))
        for node in device["queries"].values():
            lines(node)
        for endpoint, error in device["errors"].items():
            print(f"  {endpoint}: unavailable ({error})")


def main(argv):
    dev = None
    if argv[:1] in (["-d"], ["--device"]) and len(argv) > 2:
        dev, argv = argv[1], argv[2:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(__doc__)
        return

    cmd, rest = argv[0].lower(), argv[1:]

    if cmd in ("yodel-nuke", "yodel-restore"):
        if rest not in ([], ["--json"]):
            sys.exit("roku: yodel-nuke / yodel-restore accept only --json")
        import runpy
        module = os.path.join(os.path.dirname(os.path.realpath(__file__)), "roku_yodel.py")
        result = runpy.run_path(module)["run"](globals(), dev, restore=(cmd == "yodel-restore"), json_output=bool(rest))
        if result:
            sys.exit(result)
        return

    if cmd == "remember":
        if len(rest) not in (2, 3) or not valid_ip(rest[1]):
            sys.exit("roku: remember NAME IP [MAC]")
        if len(rest) == 3:
            try:
                wake_packet(rest[2])
            except ValueError:
                sys.exit("roku: invalid MAC address")
        records = registry()
        record = records.get(rest[1], {"info": {}, "reachable": None, "last_seen": None})
        record["name"] = rest[0]
        if len(rest) == 3:
            record["info"]["mac"] = rest[2]
        records[rest[1]] = record
        save_json(REGISTRY, records)
        c = load()
        c["devices"][rest[1]] = rest[0]
        save(c)
        print(f"Remembered {rest[0]} ({rest[1]})")
        return
    if cmd == "bridge":
        script = os.path.join(os.path.dirname(os.path.realpath(__file__)), "roku-ecp.cjs")
        os.execvp("node", ["node", script, "--bridge"])
    if cmd == "inventory-ui":
        viewer = os.path.join(os.path.dirname(os.path.realpath(__file__)), "roku-inventory")
        subprocess.Popen([viewer] + rest)
        return
    if cmd == "inventory":
        if rest not in ([], ["--json"]):
            sys.exit("roku: inventory accepts only --json")
        report = inventory(dev)
        if rest:
            print(json.dumps(report, indent=2))
        else:
            print_inventory(report)
        return
    if cmd in ("list", "discover"):
        c = discover()
        records = registry()
        for ip, n in c["devices"].items():
            record = records.get(ip, {})
            state = "offline / unreachable"
            if record.get("reachable"):
                state = "on" if record.get("info", {}).get("power-mode") == "PowerOn" else "standby / reachable"
            print(f"{'*' if c.get('default') == ip else ' '} {ip:15}  {n}  [{state}]")
        return
    if cmd == "default":
        ip = resolve(rest[0] if rest else sys.exit("roku default NAME"))
        c = load()
        c["default"] = ip
        save(c)
        print(f"default: {ip}  {c['devices'].get(ip, '')}")
        return

    if cmd == "launch" and not rest:
        sys.exit("roku: launch requires an app name or id")
    if cmd == "volume" and rest and (len(rest) != 1 or not re.fullmatch(r"[0-9]{1,3}", rest[0]) or not 0 <= int(rest[0]) <= 100):
        sys.exit("roku: volume accepts an integer from 0 to 100")
    ip = resolve(dev, pick_first=(cmd == "info"))

    if cmd == "volume":
        print(f"Volume: {set_volume(ip, int(rest[0])) if rest else volume(ip)}")
        return
    if cmd == "wake":
        if wake_device(ip):
            print("TV responded after Wake-on-LAN")
        else:
            sys.exit("roku: wake packets sent, but the TV has not responded. Check Fast TV Start, power, and network connection.")
        return
    if cmd == "shortcuts":
        try:
            selection = json.loads(rest[0]) if len(rest) == 1 else None
        except ValueError:
            selection = None
        if not valid_shortcuts(selection):
            sys.exit("roku: shortcuts requires four app objects with id and name")
        data = preferences()
        data[ip] = [{"id": a["id"], "name": a["name"]} for a in selection]
        save_json(PREFERENCES, data)
        print(json.dumps(data[ip]))
        return
    if cmd == "type":
        for ch in " ".join(rest):
            post(ip, "/keypress/Lit_" + urllib.parse.quote(ch, safe=""))
            time.sleep(0.05)
    elif cmd == "apps":
        for i, n in apps(ip):
            print(f"{i:>8}  {n}")
    elif cmd == "launch":
        q = " ".join(rest).lower()
        al = apps(ip)
        hits = [a for a in al if q == a[0] or q in (a[1] or "").lower()]
        exact = [a for a in hits if q == (a[1] or "").lower() or q == a[0]]
        hits = exact or hits
        if len(hits) != 1:
            sys.exit(f"roku: {len(hits)} apps match {q!r}" + "".join(f"\n  {i} {n}" for i, n in hits))
        post(ip, f"/launch/{hits[0][0]}")
        print(f"launched {hits[0][1]}")
    elif cmd == "info":
        c = load()
        saved = preferences().get(ip, [])
        record = registry().get(ip, {})
        result = {
            "ip": ip, "name": c["devices"].get(ip, record.get("name", ip)), "power": "", "app": "",
            "apps": [], "limited": False, "unreachable": False,
            "shortcuts": saved if valid_shortcuts(saved) else [],
            "wake_available": any(record.get("info", {}).get(k) for k in ("wifi-mac", "ethernet-mac", "mac")),
            "default": c.get("default"),
            "devices": [{"ip": i, "name": r["name"], "reachable": r.get("reachable")} for i, r in registry().items()],
        }
        try:
            d = get(ip, "/query/device-info")
            result["name"] = d.findtext("user-device-name") or d.findtext("friendly-device-name") or ip
            result["power"] = d.findtext("power-mode") or ""
            remember_info(ip, {child.tag: (child.text or "").strip() for child in d})
            a = get(ip, "/query/active-app").find("app")
            result["app"] = a.text if a is not None else ""
            result["apps"] = [{"id": i, "name": n} for i, n in apps(ip)]
        except urllib.error.HTTPError as e:
            if e.code != 403:
                raise
            result["limited"] = True
        except (urllib.error.URLError, OSError, ET.ParseError):
            result["unreachable"] = True
        print(json.dumps(result))
    elif cmd == "status":
        d = get(ip, "/query/device-info")
        a = get(ip, "/query/active-app").find("app")
        print(f"{d.findtext('user-device-name') or d.findtext('friendly-device-name')} "
              f"({ip}): {d.findtext('power-mode')}, app: {a.text if a is not None else '-'}")
    else:
        def keyname(tok):
            k = re.fullmatch(r"(.+?)(?:\*\d+)?", tok).group(1).lower()
            return KEYMAP.get(ALIASES.get(k, k).lower())
        if not all(keyname(t) for t in argv):  # not keys: treat as an app name
            return main((["-d", dev] if dev else []) + ["launch"] + argv)
        for tok in argv:
            m = re.fullmatch(r"(.+?)(?:\*(\d+))?", tok)
            k = m.group(1).lower()
            k = KEYMAP.get(ALIASES.get(k, k).lower())
            if not k:
                sys.exit(f"roku: unknown key or command {tok!r} (see `roku --help`)")
            for _ in range(int(m.group(2) or 1)):
                if k == "PowerOn":
                    print(power_on(ip))
                else:
                    post(ip, f"/keypress/{k}")
                time.sleep(0.08)


if __name__ == "__main__":
    try:
        main(sys.argv[1:])
    except urllib.error.HTTPError as e:
        if e.code == 403:
            sys.exit("roku: the TV refused access. On the TV: Settings > System > "
                     "Advanced system settings > Control by mobile apps > Network access > Enabled")
        sys.exit(f"roku: {e}")
    except (urllib.error.URLError, OSError) as e:
        sys.exit(f"roku: {e}")
